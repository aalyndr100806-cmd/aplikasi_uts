<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/soft_yellow">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLASSMATE"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Daftar Teman Kelas"
            android:textSize="15sp"
            android:textColor="@color/dark_text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sistem Informasi • 2026"
            android:textSize="12sp"
            android:textColor="@color/gray_text"/>

    </LinearLayout>


    <!-- ================= SEARCH ================= -->

    <EditText
        android:id="@+id/edtSearch"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_search"
        android:hint="  Cari nama atau NIM..."
        android:textColor="@color/dark_text"
        android:textColorHint="@color/gray_text"
        android:textSize="14sp"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>


    <!-- ================= JUDUL LIST ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Teman Kelas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"/>

        <TextView
            android:id="@+id/txtJumlah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 orang"
            android:textSize="12sp"
            android:textColor="@color/gray_text"/>

    </LinearLayout>


    <!-- ================= CUSTOM LISTVIEW ================= -->

    <ListView
        android:id="@+id/listTeman"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:scrollbars="none"/>

</LinearLayout>